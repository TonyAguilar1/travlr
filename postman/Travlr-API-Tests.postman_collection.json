              "path": [
                "trips"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Returns a non-empty array of trips\", () => pm.expect(json).to.be.an('array').that.is.not.empty);",
                  "pm.test(\"Each trip has the schema fields\", () => {",
                  "  ['code','name','length','start','resort','perPerson','image','description'].forEach(f => pm.expect(json[0]).to.have.property(f));",
                  "});"
                ]
              }
            }
          ]
        },
