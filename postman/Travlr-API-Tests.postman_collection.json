{
  "info": {
    "name": "Travlr Getaways API Tests",
    "description": "Positive and negative tests for the Travlr Getaways REST API (trips CRUD + JWT authentication). Start the Express server and MongoDB, then use Run collection. The run creates a throwaway user and test trip, and deletes the trip at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": ""
    },
    {
      "key": "testTripCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Setup",
      "item": [
        {
          "name": "Register new test user (positive)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique email per run so registration never collides with an earlier run",
                  "pm.collectionVariables.set(\"testEmail\", \"tester\" + Date.now() + \"@travlr.com\");",
                  "pm.collectionVariables.set(\"testPassword\", \"Test1234!\");",
                  "pm.collectionVariables.set(\"testTripCode\", \"TEST\" + String(Date.now()).slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Response contains a JWT token\", () => pm.expect(json.token).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with valid credentials (positive)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Response contains a JWT token\", () => pm.expect(json.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set(\"token\", json.token);"
                ]
              }
            }
          ]
        }
      ]
    },
